{
  "expo": {
    "name": "Afraz Kolkata",
    "slug": "afraz-kolkata",
    "scheme": "kolkataexplorer",
    "version": "1.2.4",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.afraz.kolkataexplorer",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#11172D"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d0125104-6e5e-4ce0-8802-234e5c2c77c5"
      }
    }
  }
}
